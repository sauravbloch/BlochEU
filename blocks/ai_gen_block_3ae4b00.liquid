{% doc %}
  @prompt
    replicate this text as live text style over an image as a hero banner block, copy shape of the 'arch angel' title text in this image and add to this block , add the 4 pink dots from the image underneath the title 'arch angel' , reduce the padding between the title and the dots, keep dots and title together, make dots and heading much closer, put the heading and dots in the same area and then subheading underneath, make the dots and heading as close as in this image, make the dots underneath the heading like in the image , set desktop and mobile height of the image, include the dots in the heading section, keep the line of dots in the same formation/shape., allow heading to be more than 60 whilst keeping all text on one line, allow text to be different sizes on desktop and mobile, increase padding, allow to change. make the subheading font Times New Roman, heading needs to be curved, allow full heading to be shown on desktop, make heading bigger on mobile, mobile text needs to be large, it doesn't change with toggle, when i make the heading larger it cuts off most of the letters, make it visible across the banner , allow the heading, subheading and dots to be moved up and down seperately 
{% enddoc %}
{% assign desktop_height = block.settings.desktop_height | default: 600 %}
{% assign mobile_height = block.settings.mobile_height | default: 500 %}
{% assign heading = block.settings.heading | default: 'ARCH ANGEL' %}
{% assign heading_curve = block.settings.heading_curve | default: 100 %}
{% assign heading_size_desktop = block.settings.heading_size_desktop | default: 80 %}
{% assign heading_size_mobile = block.settings.heading_size_mobile | default: 60 %}
{% assign heading_color = block.settings.heading_color | default: '#ffffff' %}
{% assign show_dots = block.settings.show_dots %}
{% assign dot_color = block.settings.dot_color | default: '#ff69b4' %}
{% assign dot_size = block.settings.dot_size | default: 12 %}
{% assign dot_spacing = block.settings.dot_spacing | default: 15 %}
{% assign heading_dots_gap = block.settings.heading_dots_gap | default: 10 %}
{% assign subheading = block.settings.subheading | default: 'Collection 2026' %}
{% assign subheading_size_desktop = block.settings.subheading_size_desktop | default: 24 %}
{% assign subheading_size_mobile = block.settings.subheading_size_mobile | default: 18 %}
{% assign subheading_color = block.settings.subheading_color | default: '#ffffff' %}
{% assign heading_group_to_subheading_gap = block.settings.heading_group_to_subheading_gap | default: 30 %}
{% assign text_alignment = block.settings.text_alignment | default: 'center' %}
{% assign heading_vertical_position = block.settings.heading_vertical_position | default: 0 %}
{% assign subheading_vertical_position = block.settings.subheading_vertical_position | default: 0 %}
{% assign padding_top = block.settings.padding_top | default: 40 %}
{% assign padding_bottom = block.settings.padding_bottom | default: 40 %}
{% assign padding_left = block.settings.padding_left | default: 40 %}
{% assign padding_right = block.settings.padding_right | default: 40 %}
{% assign overlay_opacity = block.settings.overlay_opacity | default: 30 %}
{% assign overlay_color = block.settings.overlay_color | default: '#000000' %}

<style>
  #curved-hero-{{ block.id }} {
    position: relative;
    width: 100%;
    height: {{ mobile_height }}px;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    #curved-hero-{{ block.id }} {
      height: {{ desktop_height }}px;
    }
  }

  #curved-hero-{{ block.id }} .hero-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #curved-hero-{{ block.id }} .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ overlay_color }};
    opacity: {{ overlay_opacity | divided_by: 100.0 }};
    pointer-events: none;
  }

  #curved-hero-{{ block.id }} .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: {{ text_alignment }};
    justify-content: center;
    height: 100%;
    padding: {{ padding_top }}px {{ padding_right }}px {{ padding_bottom }}px {{ padding_left }}px;
    text-align: {{ text_alignment }};
  }

  #curved-hero-{{ block.id }} .heading-dots-group {
    display: flex;
    flex-direction: column;
    align-items: {{ text_alignment }};
    gap: {{ heading_dots_gap }}px;
    width: 100%;
    transform: translateY({{ heading_vertical_position }}px);
  }

  #curved-hero-{{ block.id }} .curved-heading-container {
    position: relative;
    width: 100%;
    overflow: visible;
  }

  #curved-hero-{{ block.id }} .curved-heading {
    width: 100%;
    height: auto;
    min-height: 150px;
    overflow: visible;
  }

  @media (min-width: 768px) {
    #curved-hero-{{ block.id }} .curved-heading {
      min-height: 250px;
    }
  }

  #curved-hero-{{ block.id }} .curved-heading text {
    fill: {{ heading_color }};
    font-size: {{ heading_size_mobile }}px;
    font-weight: bold;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  @media (min-width: 768px) {
    #curved-hero-{{ block.id }} .curved-heading text {
      font-size: {{ heading_size_desktop }}px;
    }
  }

  #curved-hero-{{ block.id }} .dots-container {
    display: flex;
    gap: {{ dot_spacing }}px;
    justify-content: {{ text_alignment }};
    align-items: center;
  }

  #curved-hero-{{ block.id }} .dot {
    width: {{ dot_size }}px;
    height: {{ dot_size }}px;
    background-color: {{ dot_color }};
    border-radius: 50%;
    flex-shrink: 0;
  }

  #curved-hero-{{ block.id }} .subheading-wrapper {
    width: 100%;
    margin-top: {{ heading_group_to_subheading_gap }}px;
    transform: translateY({{ subheading_vertical_position }}px);
  }

  #curved-hero-{{ block.id }} .subheading {
    font-family: 'Times New Roman', Times, serif;
    font-size: {{ subheading_size_mobile }}px;
    color: {{ subheading_color }};
    margin: 0;
    line-height: 1.2;
  }

  @media (min-width: 768px) {
    #curved-hero-{{ block.id }} .subheading {
      font-size: {{ subheading_size_desktop }}px;
    }
  }
</style>

<div id="curved-hero-{{ block.id }}">
  {% if block.settings.image %}
    {{ block.settings.image | image_url: width: 2000 | image_tag: class: 'hero-image', loading: 'lazy' }}
  {% else %}
    <div class="hero-image" style="background-color: #cccccc;"></div>
  {% endif %}
  
  <div class="hero-overlay"></div>
  
  <div class="hero-content">
    <div class="heading-dots-group">
      <div class="curved-heading-container">
        <svg class="curved-heading" viewBox="0 0 1200 300" preserveAspectRatio="xMidYMid meet">
          <defs>
            <path id="curve-{{ block.id }}" d="M 100,250 Q 600,{{ 250 | minus: heading_curve }} 1100,250" fill="transparent"/>
          </defs>
          <text>
            <textPath href="#curve-{{ block.id }}" startOffset="50%" text-anchor="middle">
              {{ heading }}
            </textPath>
          </text>
        </svg>
      </div>
      
      {% if show_dots %}
        <div class="dots-container">
          <div class="dot"></div>
          <div class="dot"></div>
          <div class="dot"></div>
          <div class="dot"></div>
        </div>
      {% endif %}
    </div>
    
    {% if subheading != blank %}
      <div class="subheading-wrapper">
        <p class="subheading">{{ subheading }}</p>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Curved Hero Banner",
  "settings": [
    {
      "type": "header",
      "content": "Image Settings"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "min": 300,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "label": "Desktop Height",
      "default": 600
    },
    {
      "type": "range",
      "id": "mobile_height",
      "min": 200,
      "max": 800,
      "step": 50,
      "unit": "px",
      "label": "Mobile Height",
      "default": 500
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Image Overlay Opacity",
      "default": 30
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Heading Settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text",
      "default": "ARCH ANGEL"
    },
    {
      "type": "range",
      "id": "heading_curve",
      "min": 0,
      "max": 200,
      "step": 10,
      "label": "Heading Curve Amount",
      "default": 100,
      "info": "Higher values create more curve"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "min": 30,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Heading Size - Desktop",
      "default": 80
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "min": 30,
      "max": 150,
      "step": 5,
      "unit": "px",
      "label": "Heading Size - Mobile",
      "default": 60
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "heading_vertical_position",
      "min": -300,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Heading Vertical Position",
      "default": 0,
      "info": "Move heading and dots up (negative) or down (positive)"
    },
    {
      "type": "header",
      "content": "Dots Settings"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show Dots",
      "default": true
    },
    {
      "type": "color",
      "id": "dot_color",
      "label": "Dot Color",
      "default": "#ff69b4"
    },
    {
      "type": "range",
      "id": "dot_size",
      "min": 5,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Dot Size",
      "default": 12
    },
    {
      "type": "range",
      "id": "dot_spacing",
      "min": 5,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Space Between Dots",
      "default": 15
    },
    {
      "type": "range",
      "id": "heading_dots_gap",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Gap Between Heading and Dots",
      "default": 10
    },
    {
      "type": "header",
      "content": "Subheading Settings"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading Text",
      "default": "Collection 2026"
    },
    {
      "type": "range",
      "id": "subheading_size_desktop",
      "min": 12,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Subheading Size - Desktop",
      "default": 24
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "min": 12,
      "max": 50,
      "step": 2,
      "unit": "px",
      "label": "Subheading Size - Mobile",
      "default": 18
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "heading_group_to_subheading_gap",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Gap Between Dots and Subheading",
      "default": 30
    },
    {
      "type": "range",
      "id": "subheading_vertical_position",
      "min": -300,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Subheading Vertical Position",
      "default": 0,
      "info": "Move subheading up (negative) or down (positive)"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Left",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 200,
      "step": 10,
      "unit": "px",
      "label": "Padding Right",
      "default": 40
    }
  ]
}
{% endschema %}