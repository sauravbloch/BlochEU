{% doc %}
  @prompt
    can you create me a rich text block that matches the collection title and description as used on the site, heading font - aime, description font - univers sans, allow the text to sit desktop width, can you make the heading and description automatically pull through from the collection being used on the template, heading font aime, description univers sans, add padding toggles, heading font aime, description font univers sans
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-copy-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    color: {{ block.settings.text_color }};
    {% if block.settings.padding_top %}padding-top: {{ block.settings.vertical_padding }}px;{% endif %}
    {% if block.settings.padding_bottom %}padding-bottom: {{ block.settings.vertical_padding }}px;{% endif %}
  }

  .ai-collection-copy-{{ ai_gen_id }}__heading {
    margin: 0 0 {{ block.settings.content_gap }}px;
    color: inherit;
    font-family: 'Aime', {{ block.settings.heading_font.fallback_families }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.15;
  }

  .ai-collection-copy-{{ ai_gen_id }}__description {
    color: inherit;
    font-family: 'Univers Sans', {{ block.settings.description_font.fallback_families }};
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.5;
  }

  .ai-collection-copy-{{ ai_gen_id }}__description > :first-child { margin-top: 0; }
  .ai-collection-copy-{{ ai_gen_id }}__description > :last-child { margin-bottom: 0; }

  @media screen and (max-width: 749px) {
    .ai-collection-copy-{{ ai_gen_id }} { width: 100%; }
    .ai-collection-copy-{{ ai_gen_id }}__heading { font-size: {{ block.settings.heading_size | times: 0.8 }}px; }
    .ai-collection-copy-{{ ai_gen_id }}__description { font-size: {{ block.settings.description_size | times: 0.9 }}px; }
  }
{% endstyle %}

<div class="ai-collection-copy-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if collection != blank %}
    {% if block.settings.show_heading and collection.title != blank %}
      <h2 class="ai-collection-copy-{{ ai_gen_id }}__heading">{{ collection.title | escape }}</h2>
    {% endif %}
    {% if block.settings.show_description and collection.description != blank %}
      <div class="ai-collection-copy-{{ ai_gen_id }}__description">{{ collection.description }}</div>
    {% endif %}
  {% else %}
    {% if block.settings.show_heading %}<h2 class="ai-collection-copy-{{ ai_gen_id }}__heading">Collection title</h2>{% endif %}
    {% if block.settings.show_description %}<div class="ai-collection-copy-{{ ai_gen_id }}__description">Collection description will appear here when used on a collection page.</div>{% endif %}
  {% endif %}
</div>

{% schema %}
{
  "name": "Collection title and text",
  "settings": [
    { "type": "checkbox", "id": "show_heading", "label": "Show heading", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "Show description", "default": true },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font fallback", "default": "sans-serif" },
    { "type": "font_picker", "id": "description_font", "label": "Description font fallback", "default": "sans-serif" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 20, "max": 60, "step": 2, "unit": "px", "default": 34 },
    { "type": "range", "id": "description_size", "label": "Description size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "content_gap", "label": "Gap", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 12 },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#0E0E0E" },
    { "type": "checkbox", "id": "padding_top", "label": "Add top padding", "default": false },
    { "type": "checkbox", "id": "padding_bottom", "label": "Add bottom padding", "default": false },
    { "type": "range", "id": "vertical_padding", "label": "Padding amount", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 }
  ],
  "presets": [
    { "name": "Collection title and text" }
  ],
  "tag": null,
  "class": "collection-title-description-block"
}
{% endschema %}