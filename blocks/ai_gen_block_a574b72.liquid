{% doc %}
  @prompt
    add a mutlicolumn block that allows for html code in the heading with 3 columns below with heading, subheading and cta links, allow for an image in each column
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-multicolumn-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-multicolumn-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-multicolumn-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-multicolumn-heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    line-height: 1.2;
    margin: 0;
  }

  .ai-multicolumn-columns-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-multicolumn-column-{{ ai_gen_id }} {
    text-align: {{ block.settings.column_alignment }};
  }

  .ai-multicolumn-column-image-wrapper-{{ ai_gen_id }} {
    margin-bottom: {{ block.settings.image_spacing }}px;
  }

  .ai-multicolumn-column-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-multicolumn-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-multicolumn-image-placeholder-{{ ai_gen_id }} svg {
    width: 50%;
    height: 50%;
    opacity: 0.3;
  }

  .ai-multicolumn-column-heading-{{ ai_gen_id }} {
    color: {{ block.settings.column_heading_color }};
    font-size: {{ block.settings.column_heading_size }}px;
    line-height: 1.3;
    margin: 0 0 {{ block.settings.column_heading_spacing }}px 0;
  }

  .ai-multicolumn-column-subheading-{{ ai_gen_id }} {
    color: {{ block.settings.column_subheading_color }};
    font-size: {{ block.settings.column_subheading_size }}px;
    line-height: 1.5;
    margin: 0 0 {{ block.settings.column_subheading_spacing }}px 0;
  }

  .ai-multicolumn-column-link-{{ ai_gen_id }} {
    display: inline-block;
    color: {{ block.settings.link_color }};
    text-decoration: {{ block.settings.link_style }};
    font-size: {{ block.settings.link_size }}px;
    transition: color 0.3s ease;
  }

  .ai-multicolumn-column-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.link_hover_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-multicolumn-columns-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-multicolumn-columns-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }

    .ai-multicolumn-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }

    .ai-multicolumn-column-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.column_heading_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-multicolumn-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-multicolumn-container-{{ ai_gen_id }}">
    {% if block.settings.main_heading != blank %}
      <div class="ai-multicolumn-header-{{ ai_gen_id }}">
        <div class="ai-multicolumn-heading-{{ ai_gen_id }}">
          {{ block.settings.main_heading }}
        </div>
      </div>
    {% endif %}

    <div class="ai-multicolumn-columns-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign image_key = 'column_' | append: i | append: '_image'
          assign heading_key = 'column_' | append: i | append: '_heading'
          assign subheading_key = 'column_' | append: i | append: '_subheading'
          assign link_text_key = 'column_' | append: i | append: '_link_text'
          assign link_url_key = 'column_' | append: i | append: '_link_url'

          assign column_image = block.settings[image_key]
          assign column_heading = block.settings[heading_key]
          assign column_subheading = block.settings[subheading_key]
          assign link_text = block.settings[link_text_key]
          assign link_url = block.settings[link_url_key]
        %}

        <div class="ai-multicolumn-column-{{ ai_gen_id }}">
          <div class="ai-multicolumn-column-image-wrapper-{{ ai_gen_id }}">
            {% if column_image %}
              <img
                src="{{ column_image | image_url: width: 600 }}"
                alt="{{ column_image.alt | escape }}"
                loading="lazy"
                width="{{ column_image.width }}"
                height="{{ column_image.height }}"
                class="ai-multicolumn-column-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-multicolumn-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          {% if column_heading != blank %}
            <h3 class="ai-multicolumn-column-heading-{{ ai_gen_id }}">
              {{ column_heading }}
            </h3>
          {% endif %}

          {% if column_subheading != blank %}
            <div class="ai-multicolumn-column-subheading-{{ ai_gen_id }}">
              {{ column_subheading }}
            </div>
          {% endif %}

          {% if link_text != blank %}
            <a 
              href="{{ link_url }}" 
              class="ai-multicolumn-column-link-{{ ai_gen_id }}"
            >
              {{ link_text }}
            </a>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

