{% doc %}
  @prompt
    create a split banner block like the templates but allow the font to be changed to one of these options Serif font: Aime, Sans-serif font: Univers Sans, Wide bold font: Monument, split banner block should include a left and right banner, left banner to be 75 and right to be 35 width, width 70 of left banner and 10 space between, allow different text font, position, size and colour for the left and right heading, subheading and CTA link, make the CTA links instead of buttons, left banner text to sit under the image on mobile, different text size, position and colour on desktop and mobile versions, allow heading and subheading text to be different fonts please, make sure the text overlay shows below image on mobile with a white background and black text, height of 600 for desktop, allow the mobile to make the images aspect ratio e.g. landscape, portrait, mobile image shape different for left and right banners, allow heading text to be bold on left banner, left and right banner to have different font styles, sizes and weights, different size font on desktop and mobile, allow to change text position on left and right images, right banner to use Aime font as the heading font, remove the overlay changing the images colour, different mobile image ratio for left and right banner images, change text position to top, centre, bottom, reduce the text width of the left banner, allow for text size, width, and position to be different on mobile. allow for text font to be different on each banner, allow for text placement to be different on each banner, can we increase padding at the top of this split banner
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-split-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;padding-top:{{ block.settings.top_padding }}px}.ai-split-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:75fr 35fr;gap:{{ block.settings.gap }}px;height:{{ block.settings.desktop_height }}px}.ai-split-{{ ai_gen_id }}__panel{position:relative;overflow:hidden;background:#fff}.ai-split-{{ ai_gen_id }}__image,.ai-split-{{ ai_gen_id }}__placeholder{display:block;width:100%;height:100%;object-fit:cover}.ai-split-{{ ai_gen_id }}__placeholder{position:relative;background:#efefef}.ai-split-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%;color:#777}.ai-split-{{ ai_gen_id }}__empty{position:absolute;bottom:20px;left:10%;width:80%;text-align:center;color:#333;font-size:13px}.ai-split-{{ ai_gen_id }}__content{position:absolute;inset:0;display:flex;flex-direction:column;align-items:{{ block.settings.left_align }};justify-content:{{ block.settings.left_position }};padding:{{ block.settings.desktop_padding }}px;color:{{ block.settings.left_color }};text-align:{{ block.settings.left_align }}}.ai-split-{{ ai_gen_id }}__panel--right .ai-split-{{ ai_gen_id }}__content{align-items:{{ block.settings.right_align }};justify-content:{{ block.settings.right_position }};color:{{ block.settings.right_color }};text-align:{{ block.settings.right_align }}}.ai-split-{{ ai_gen_id }}__heading,.ai-split-{{ ai_gen_id }}__subheading{max-width:var(--width);margin:0}.ai-split-{{ ai_gen_id }}__heading{--width:{{ block.settings.left_text_width }}%;font-family:{{ block.settings.left_heading_font }};font-size:{{ block.settings.left_heading_size }}px;font-weight:{{ block.settings.left_heading_weight }};line-height:1.05}.ai-split-{{ ai_gen_id }}__subheading{--width:{{ block.settings.left_text_width }}%;margin-top:12px;font-family:{{ block.settings.left_subheading_font }};font-size:{{ block.settings.left_subheading_size }}px}.ai-split-{{ ai_gen_id }}__panel--right .ai-split-{{ ai_gen_id }}__heading{--width:{{ block.settings.right_text_width }}%;font-family:{{ block.settings.right_heading_font }};font-size:{{ block.settings.right_heading_size }}px;font-weight:{{ block.settings.right_heading_weight }}}.ai-split-{{ ai_gen_id }}__panel--right .ai-split-{{ ai_gen_id }}__subheading{--width:{{ block.settings.right_text_width }}%;font-family:{{ block.settings.right_subheading_font }};font-size:{{ block.settings.right_subheading_size }}px}.ai-split-{{ ai_gen_id }}__link{margin-top:18px;color:inherit;font-size:{{ block.settings.left_cta_size }}px;font-weight:600;text-decoration:underline;text-underline-offset:4px}.ai-split-{{ ai_gen_id }}__panel--right .ai-split-{{ ai_gen_id }}__link{font-size:{{ block.settings.right_cta_size }}px}@media(max-width:749px){.ai-split-{{ ai_gen_id }}{padding-top:{{ block.settings.mobile_top_padding }}px}.ai-split-{{ ai_gen_id }}__grid{grid-template-columns:1fr;height:auto;gap:{{ block.settings.mobile_gap }}px}.ai-split-{{ ai_gen_id }}__panel{display:flex;flex-direction:column}.ai-split-{{ ai_gen_id }}__image,.ai-split-{{ ai_gen_id }}__placeholder{height:auto;aspect-ratio:{{ block.settings.left_mobile_ratio }}}.ai-split-{{ ai_gen_id }}__panel--right .ai-split-{{ ai_gen_id }}__image,.ai-split-{{ ai_gen_id }}__panel--right .ai-split-{{ ai_gen_id }}__placeholder{aspect-ratio:{{ block.settings.right_mobile_ratio }}}.ai-split-{{ ai_gen_id }}__content,.ai-split-{{ ai_gen_id }}__panel--right .ai-split-{{ ai_gen_id }}__content{position:static;min-height:150px;height:auto;align-items:{{ block.settings.left_mobile_align }};justify-content:{{ block.settings.left_mobile_position }};padding:{{ block.settings.mobile_padding }}px;background:#fff;color:#000;text-align:{{ block.settings.left_mobile_align }}}.ai-split-{{ ai_gen_id }}__panel--right .ai-split-{{ ai_gen_id }}__content{align-items:{{ block.settings.right_mobile_align }};justify-content:{{ block.settings.right_mobile_position }};text-align:{{ block.settings.right_mobile_align }}}.ai-split-{{ ai_gen_id }}__heading,.ai-split-{{ ai_gen_id }}__panel--right .ai-split-{{ ai_gen_id }}__heading{max-width:{{ block.settings.mobile_text_width }}%;font-size:{{ block.settings.mobile_heading_size }}px;color:#000}.ai-split-{{ ai_gen_id }}__subheading,.ai-split-{{ ai_gen_id }}__panel--right .ai-split-{{ ai_gen_id }}__subheading{max-width:{{ block.settings.mobile_text_width }}%;font-size:{{ block.settings.mobile_subheading_size }}px;color:#000}.ai-split-{{ ai_gen_id }}__link,.ai-split-{{ ai_gen_id }}__panel--right .ai-split-{{ ai_gen_id }}__link{font-size:{{ block.settings.mobile_cta_size }}px;color:#000}}
{% endstyle %}
<div class="ai-split-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-split-{{ ai_gen_id }}__grid">{% for side in (1..2) %}{% if side == 1 %}{% assign image=block.settings.left_image %}{% assign heading=block.settings.left_heading %}{% assign subheading=block.settings.left_subheading %}{% assign cta=block.settings.left_cta %}{% assign link=block.settings.left_link %}{% assign panel='' %}{% else %}{% assign image=block.settings.right_image %}{% assign heading=block.settings.right_heading %}{% assign subheading=block.settings.right_subheading %}{% assign cta=block.settings.right_cta %}{% assign link=block.settings.right_link %}{% assign panel='ai-split-' | append: ai_gen_id | append: '__panel--right' %}{% endif %}<div class="ai-split-{{ ai_gen_id }}__panel {{ panel }}">{% if image %}<img class="ai-split-{{ ai_gen_id }}__image" src="{{ image | image_url: width: 1800 }}" alt="{{ image.alt | escape }}" loading="lazy">{% else %}<div class="ai-split-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}<span class="ai-split-{{ ai_gen_id }}__empty">Add an image for this banner</span></div>{% endif %}<div class="ai-split-{{ ai_gen_id }}__content">{% if heading != blank %}<h2 class="ai-split-{{ ai_gen_id }}__heading">{{ heading }}</h2>{% endif %}{% if subheading != blank %}<div class="ai-split-{{ ai_gen_id }}__subheading">{{ subheading }}</div>{% endif %}{% if cta != blank and link != blank %}<a class="ai-split-{{ ai_gen_id }}__link" href="{{ link }}">{{ cta }}</a>{% endif %}</div></div>{% endfor %}</div></div>
