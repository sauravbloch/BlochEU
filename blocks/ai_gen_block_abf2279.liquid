{% doc %}
  @prompt
    Generate a product badge that is consistent in look & size to our 'Sale' badges. This product badge should allow for a dynamic source to be added from a metafield. The badge should be shown on the product page and collection pages. The colour should be editable in the theme editor.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign badge_text = ''
  
  if block.settings.badge_source == 'metafield' and block.settings.metafield_namespace != blank and block.settings.metafield_key != blank
    assign metafield_value = product.metafields[block.settings.metafield_namespace][block.settings.metafield_key]
    if metafield_value != blank
      assign badge_text = metafield_value
    endif
  elsif block.settings.badge_source == 'custom' and block.settings.custom_text != blank
    assign badge_text = block.settings.custom_text
  endif
%}

{% if badge_text != blank %}
  {% style %}
    .ai-product-badge-{{ ai_gen_id }} {
      position: absolute;
      top: {{ block.settings.position_top }}px;
      left: {{ block.settings.position_left }}px;
      z-index: 10;
      background-color: {{ block.settings.badge_color }};
      color: {{ block.settings.text_color }};
      padding: 6px 12px;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      line-height: 1.2;
      border-radius: {{ block.settings.border_radius }}px;
      display: inline-block;
      max-width: calc(100% - {{ block.settings.position_left | times: 2 }}px);
      word-wrap: break-word;
    }

    @media screen and (max-width: 749px) {
      .ai-product-badge-{{ ai_gen_id }} {
        font-size: 11px;
        padding: 5px 10px;
      }
    }
  {% endstyle %}

  <div class="ai-product-badge-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    {{ badge_text }}
  </div>
{% endif %}

{% schema %}
{
  "name": "Product badge",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Badge source"
    },
    {
      "type": "select",
      "id": "badge_source",
      "label": "Badge source",
      "options": [
        {
          "value": "metafield",
          "label": "Product metafield"
        },
        {
          "value": "custom",
          "label": "Custom text"
        }
      ],
      "default": "metafield"
    },
    {
      "type": "text",
      "id": "metafield_namespace",
      "label": "Metafield namespace",
      "info": "Example: custom"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Metafield key",
      "info": "Example: badge_text"
    },
    {
      "type": "text",
      "id": "custom_text",
      "label": "Custom text",
      "info": "Only used when source is set to Custom text"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Background",
      "default": "#7c0e0a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "border_radius",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Border radius",
      "default": 0
    },
    {
      "type": "header",
      "content": "Position"
    },
    {
      "type": "range",
      "id": "position_top",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Top",
      "default": 10
    },
    {
      "type": "range",
      "id": "position_left",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Left",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Product badge"
    }
  ]
}
{% endschema %}