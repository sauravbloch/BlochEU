{% doc %}
  @prompt
    create a multi column section with 10 padding at top and bottom, with space for three images in a row add a heading and copy under each image with the option to change alignment. add a heading above the images in the middle with the option to change alignment, make sure all text can be changed in size., allow the distance between the top heading and the three images to be adjustable, allow padding to be adjusted on the sides for the whole block , allow alignmet of the whole block so that when i reduce desktop width it can be centered
{% enddoc %}
{% schema %}
{
  "name": "Multi Column with Images",
  "settings": [
    {
      "type": "header",
      "content": "Section Heading"
    },
    {
      "type": "text",
      "id": "section_heading",
      "label": "Heading",
      "default": "Our Features"
    },
    {
      "type": "range",
      "id": "section_heading_size",
      "min": 16,
      "max": 60,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 34
    },
    {
      "type": "select",
      "id": "section_heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Space between heading and images",
      "default": 40
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "block_alignment",
      "label": "Block alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "flex-end",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 10
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding left and right",
      "default": 20
    },
    {
      "type": "header",
      "content": "Column 1"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Image 1"
    },
    {
      "type": "text",
      "id": "heading_1",
      "label": "Heading 1",
      "default": "First Column"
    },
    {
      "type": "range",
      "id": "heading_size_1",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 20
    },
    {
      "type": "richtext",
      "id": "text_1",
      "label": "Text 1",
      "default": "<p>Add your description here</p>"
    },
    {
      "type": "range",
      "id": "text_size_1",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 14
    },
    {
      "type": "select",
      "id": "alignment_1",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Column 2"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Image 2"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "Heading 2",
      "default": "Second Column"
    },
    {
      "type": "range",
      "id": "heading_size_2",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 20
    },
    {
      "type": "richtext",
      "id": "text_2",
      "label": "Text 2",
      "default": "<p>Add your description here</p>"
    },
    {
      "type": "range",
      "id": "text_size_2",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 14
    },
    {
      "type": "select",
      "id": "alignment_2",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Column 3"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Image 3"
    },
    {
      "type": "text",
      "id": "heading_3",
      "label": "Heading 3",
      "default": "Third Column"
    },
    {
      "type": "range",
      "id": "heading_size_3",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Heading size",
      "default": 20
    },
    {
      "type": "richtext",
      "id": "text_3",
      "label": "Text 3",
      "default": "<p>Add your description here</p>"
    },
    {
      "type": "range",
      "id": "text_size_3",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "label": "Text size",
      "default": 14
    },
    {
      "type": "select",
      "id": "alignment_3",
      "label": "Content alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    }
  ]
}
{% endschema %}

<style>
  .multi-column-section-{{ block.id }} {
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-left: {{ block.settings.padding_sides }}px;
    padding-right: {{ block.settings.padding_sides }}px;
  }

  .multi-column-wrapper-{{ block.id }} {
    display: flex;
    justify-content: {{ block.settings.block_alignment }};
    width: 100%;
  }

  .multi-column-container-{{ block.id }} {
    max-width: 100%;
  }

  .section-heading-{{ block.id }} {
    font-size: {{ block.settings.section_heading_size }}px;
    text-align: {{ block.settings.section_heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
    color: #0e0e0e;
    line-height: 1.1em;
    letter-spacing: -0.25px;
    margin-top: 0;
  }

  .columns-row-{{ block.id }} {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    justify-content: center;
  }

  .column-item-{{ block.id }} {
    flex: 1;
    min-width: 250px;
    max-width: 350px;
  }

  .column-image-{{ block.id }} {
    width: 100%;
    height: auto;
    display: block;
    margin-bottom: 20px;
  }

  .column-heading-{{ block.id }} {
    margin-bottom: 10px;
    margin-top: 0;
    color: #0e0e0e;
    line-height: 1.1em;
  }

  .column-text-{{ block.id }} {
    color: #0e0e0e;
    line-height: 1.4em;
    letter-spacing: 0.25px;
  }

  .column-text-{{ block.id }} p {
    margin: 0;
  }

  @media screen and (max-width: 768px) {
    .columns-row-{{ block.id }} {
      flex-direction: column;
      align-items: center;
    }

    .column-item-{{ block.id }} {
      max-width: 100%;
    }
  }
</style>

<div class="multi-column-section-{{ block.id }}">
  <div class="multi-column-wrapper-{{ block.id }}">
    <div class="multi-column-container-{{ block.id }}">
      {% if block.settings.section_heading != blank %}
        <h2 class="section-heading-{{ block.id }}">{{ block.settings.section_heading }}</h2>
      {% endif %}

      <div class="columns-row-{{ block.id }}">
        {% for i in (1..3) %}
          {% assign image_key = 'image_' | append: i %}
          {% assign heading_key = 'heading_' | append: i %}
          {% assign heading_size_key = 'heading_size_' | append: i %}
          {% assign text_key = 'text_' | append: i %}
          {% assign text_size_key = 'text_size_' | append: i %}
          {% assign alignment_key = 'alignment_' | append: i %}
          
          {% assign column_image = block.settings[image_key] %}
          {% assign column_heading = block.settings[heading_key] %}
          {% assign column_heading_size = block.settings[heading_size_key] %}
          {% assign column_text = block.settings[text_key] %}
          {% assign column_text_size = block.settings[text_size_key] %}
          {% assign column_alignment = block.settings[alignment_key] %}

          <div class="column-item-{{ block.id }}" style="text-align: {{ column_alignment }};">
            {% if column_image != blank %}
              <img 
                src="{{ column_image | img_url: '600x' }}" 
                alt="{{ column_image.alt | escape }}"
                class="column-image-{{ block.id }}"
                loading="lazy"
              >
            {% else %}
              <div class="column-image-{{ block.id }}" style="background-color: #f0f0f0; aspect-ratio: 1/1;"></div>
            {% endif %}

            {% if column_heading != blank %}
              <h3 class="column-heading-{{ block.id }}" style="font-size: {{ column_heading_size }}px;">
                {{ column_heading }}
              </h3>
            {% endif %}

            {% if column_text != blank %}
              <div class="column-text-{{ block.id }}" style="font-size: {{ column_text_size }}px;">
                {{ column_text }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</div>