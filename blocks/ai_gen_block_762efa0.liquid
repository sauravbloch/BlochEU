{% doc %}
  @prompt
    can you create a column block that will appear as a row of 4 on desktop but will appear as a row of 4 that is able to scroll on mobile, show 2 columns on screen before scroll on mobile, can you give the block a heading and 2 subheading blocks, with the option to have 5 columns but can be hidden, allow for an image in each column, make scrollable between columns on mobile, allow to scroll across all columns on mobile, show scroll bar underneath columns, reduce top padding, allow heading text to change font , ensure each image can be linked to, for each of the columns can we have  heading and subheading text. can we allow edits to layout including desktop width and padding, when 5 columns are selected can they appear on same row and when column is hidden on desktop also hide column on mobile
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-scrollable-columns-{{ ai_gen_id }} {
    width: 100%;
    display: block;
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
  }

  .ai-scrollable-columns__inner-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
  }

  .ai-scrollable-columns__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 32px;
  }

  .ai-scrollable-columns__heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 12px 0;
    color: {{ block.settings.heading_color }};
  }

  .ai-scrollable-columns__subheading-1-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_1_size }}px;
    margin: 0 0 8px 0;
    color: {{ block.settings.subheading_1_color }};
  }

  .ai-scrollable-columns__subheading-2-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_2_size }}px;
    margin: 0;
    color: {{ block.settings.subheading_2_color }};
  }

  .ai-scrollable-columns__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    gap: {{ block.settings.column_gap }}px;
  }

  .ai-scrollable-columns__column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-scrollable-columns__column-{{ ai_gen_id }}.hidden {
    display: none;
  }

  .ai-scrollable-columns__image-link-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-scrollable-columns__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-scrollable-columns__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-scrollable-columns__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-scrollable-columns__image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-scrollable-columns__text-wrapper-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-scrollable-columns__column-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.column_heading_size }}px;
    margin: 0 0 8px 0;
    color: {{ block.settings.column_heading_color }};
  }

  .ai-scrollable-columns__column-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.column_subheading_size }}px;
    margin: 0;
    color: {{ block.settings.column_subheading_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-scrollable-columns__grid-{{ ai_gen_id }} {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: {{ block.settings.column_gap_mobile }}px;
      padding-bottom: 16px;
      scrollbar-width: thin;
      scrollbar-color: {{ block.settings.scrollbar_color }} {{ block.settings.scrollbar_track_color }};
    }

    .ai-scrollable-columns__grid-{{ ai_gen_id }}::-webkit-scrollbar {
      height: 8px;
    }

    .ai-scrollable-columns__grid-{{ ai_gen_id }}::-webkit-scrollbar-track {
      background: {{ block.settings.scrollbar_track_color }};
      border-radius: 4px;
    }

    .ai-scrollable-columns__grid-{{ ai_gen_id }}::-webkit-scrollbar-thumb {
      background: {{ block.settings.scrollbar_color }};
      border-radius: 4px;
    }

    .ai-scrollable-columns__column-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - {{ block.settings.column_gap_mobile }}px) / 2);
      scroll-snap-align: start;
    }
  }
{% endstyle %}

<scrollable-columns-{{ ai_gen_id }} class="ai-scrollable-columns-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-scrollable-columns__inner-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading_1 != blank or block.settings.subheading_2 != blank %}
      <div class="ai-scrollable-columns__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-scrollable-columns__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading_1 != blank %}
          <div class="ai-scrollable-columns__subheading-1-{{ ai_gen_id }}">{{ block.settings.subheading_1 }}</div>
        {% endif %}
        {% if block.settings.subheading_2 != blank %}
          <div class="ai-scrollable-columns__subheading-2-{{ ai_gen_id }}">{{ block.settings.subheading_2 }}</div>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-scrollable-columns__grid-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign image_key = 'column_' | append: i | append: '_image'
          assign link_key = 'column_' | append: i | append: '_link'
          assign heading_key = 'column_' | append: i | append: '_heading'
          assign subheading_key = 'column_' | append: i | append: '_subheading'
          assign show_key = 'show_column_' | append: i

          assign column_image = block.settings[image_key]
          assign column_link = block.settings[link_key]
          assign column_heading = block.settings[heading_key]
          assign column_subheading = block.settings[subheading_key]
          assign show_column = block.settings[show_key]
        %}

        <div class="ai-scrollable-columns__column-{{ ai_gen_id }} {% unless show_column %}hidden{% endunless %}">
          {% if column_link != blank %}
            <a href="{{ column_link }}" class="ai-scrollable-columns__image-link-{{ ai_gen_id }}">
          {% endif %}
            <div class="ai-scrollable-columns__image-wrapper-{{ ai_gen_id }}">
              {% if column_image %}
                <img
                  src="{{ column_image | image_url: width: 600 }}"
                  alt="{{ column_image.alt | escape }}"
                  loading="lazy"
                  width="{{ column_image.width }}"
                  height="{{ column_image.height }}"
                  class="ai-scrollable-columns__image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-scrollable-columns__image-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
          {% if column_link != blank %}
            </a>
          {% endif %}

          {% if column_heading != blank or column_subheading != blank %}
            <div class="ai-scrollable-columns__text-wrapper-{{ ai_gen_id }}">
              {% if column_heading != blank %}
                <h3 class="ai-scrollable-columns__column-heading-{{ ai_gen_id }}">{{ column_heading }}</h3>
              {% endif %}
              {% if column_subheading != blank %}
                <div class="ai-scrollable-columns__column-subheading-{{ ai_gen_id }}">{{ column_subheading }}</div>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</scrollable-columns-{{ ai_gen_id }}>

<script>
  (function() {
    class ScrollableColumns{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupAccessibility();
      }

      setupAccessibility() {
        const grid = this.querySelector('.ai-scrollable-columns__grid-{{ ai_gen_id }}');
        if (grid && window.innerWidth <= 749) {
          grid.setAttribute('role', 'region');
          grid.setAttribute('aria-label', 'Scrollable columns');
          grid.setAttribute('tabindex', '0');
        }
      }
    }

    customElements.define('scrollable-columns-{{ ai_gen_id }}', ScrollableColumns{{ ai_gen_id }});
  })();
</script>

