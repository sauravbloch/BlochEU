{% doc %}
  @prompt
    create a split image block which allow the left bigger banner to have the same features as this screenshot, matching text font and ability to change the heading, subheading and CTA to be a button or link, right banner should allow for a link CTA, make the font Montserrat, increase the spacing between the letters of the heading, add heading and subheading to the right banner, right banner need to have the cta show, give the option to move heading and subheading text position with toggle,cta can be link or button option, allow the text font to be montserrat for the heading, subheading, CTA. change the text position via toggle. allow banner layout to be changed via toggle for these options: Desktop width, Left banner width, Banner height (desktop), Banner height (mobile), Gap between banners (desktop), Gap between banners (mobile), Border radius, allow to change the banner text font, give options including montserrat, allow the heading font to be light, ultra light, bold, ultra bond etc, centre the text (heading, subheading, cta) in the middle of the left banner, allow the bottom spacing the be changed via toggle (up to 40), allow bottom spacing to be changed under the heading and subheading, allow the CTA font to be extra bold , allow the stroke wight to be changed for the heading and CTA for the right banner 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-split-banner-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-bottom: {{ block.settings.bottom_spacing }}px;
  }

  .ai-split-banner__container-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.gap_desktop }}px;
  }

  .ai-split-banner__left-{{ ai_gen_id }} {
    position: relative;
    width: {{ block.settings.left_banner_width }}%;
    height: {{ block.settings.banner_height_desktop }}px;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-split-banner__right-{{ ai_gen_id }} {
    position: relative;
    width: calc(100% - {{ block.settings.left_banner_width }}%);
    height: {{ block.settings.banner_height_desktop }}px;
    border-radius: {{ block.settings.border_radius }}px;
    overflow: hidden;
  }

  .ai-split-banner__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-split-banner__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-split-banner__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-split-banner__content-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 30px;
    text-align: center;
  }

  .ai-split-banner__content--top-left-{{ ai_gen_id }} {
    justify-content: flex-start;
    align-items: flex-start;
    text-align: left;
  }

  .ai-split-banner__content--top-center-{{ ai_gen_id }} {
    justify-content: flex-start;
    align-items: center;
    text-align: center;
  }

  .ai-split-banner__content--top-right-{{ ai_gen_id }} {
    justify-content: flex-start;
    align-items: flex-end;
    text-align: right;
  }

  .ai-split-banner__content--middle-left-{{ ai_gen_id }} {
    justify-content: center;
    align-items: flex-start;
    text-align: left;
  }

  .ai-split-banner__content--middle-center-{{ ai_gen_id }} {
    justify-content: center;
    align-items: center;
    text-align: center;
  }

  .ai-split-banner__content--middle-right-{{ ai_gen_id }} {
    justify-content: center;
    align-items: flex-end;
    text-align: right;
  }

  .ai-split-banner__content--bottom-left-{{ ai_gen_id }} {
    justify-content: flex-end;
    align-items: flex-start;
    text-align: left;
  }

  .ai-split-banner__content--bottom-center-{{ ai_gen_id }} {
    justify-content: flex-end;
    align-items: center;
    text-align: center;
  }

  .ai-split-banner__content--bottom-right-{{ ai_gen_id }} {
    justify-content: flex-end;
    align-items: flex-end;
    text-align: right;
  }

  .ai-split-banner__heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font }}, sans-serif;
    font-weight: {{ block.settings.heading_font_weight }};
    font-size: {{ block.settings.left_heading_size }}px;
    color: {{ block.settings.left_heading_color }};
    letter-spacing: {{ block.settings.left_heading_letter_spacing }}px;
    margin: 0 0 {{ block.settings.left_heading_bottom_spacing }}px 0;
  }

  .ai-split-banner__subheading-{{ ai_gen_id }} {
    font-family: {{ block.settings.subheading_font }}, sans-serif;
    font-size: {{ block.settings.left_subheading_size }}px;
    color: {{ block.settings.left_subheading_color }};
    margin: 0 0 {{ block.settings.left_subheading_bottom_spacing }}px 0;
  }

  .ai-split-banner__cta-button-{{ ai_gen_id }} {
    font-family: {{ block.settings.cta_font }}, sans-serif;
    font-weight: {{ block.settings.cta_font_weight }};
    display: inline-block;
    padding: 12px 30px;
    background-color: {{ block.settings.left_cta_bg_color }};
    color: {{ block.settings.left_cta_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.left_cta_border_radius }}px;
    font-size: {{ block.settings.left_cta_size }}px;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-split-banner__cta-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.left_cta_hover_bg_color }};
    color: {{ block.settings.left_cta_hover_text_color }};
  }

  .ai-split-banner__cta-link-{{ ai_gen_id }} {
    font-family: {{ block.settings.cta_font }}, sans-serif;
    font-weight: {{ block.settings.cta_font_weight }};
    color: {{ block.settings.left_cta_text_color }};
    text-decoration: underline;
    font-size: {{ block.settings.left_cta_size }}px;
  }

  .ai-split-banner__cta-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.left_cta_hover_text_color }};
  }

  .ai-split-banner__right-heading-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font }}, sans-serif;
    font-weight: {{ block.settings.right_heading_font_weight }};
    font-size: {{ block.settings.right_heading_size }}px;
    color: {{ block.settings.right_heading_color }};
    letter-spacing: {{ block.settings.right_heading_letter_spacing }}px;
    margin: 0 0 {{ block.settings.right_heading_bottom_spacing }}px 0;
  }

  .ai-split-banner__right-subheading-{{ ai_gen_id }} {
    font-family: {{ block.settings.subheading_font }}, sans-serif;
    font-size: {{ block.settings.right_subheading_size }}px;
    color: {{ block.settings.right_subheading_color }};
    margin: 0 0 {{ block.settings.right_subheading_bottom_spacing }}px 0;
  }

  .ai-split-banner__right-cta-button-{{ ai_gen_id }} {
    font-family: {{ block.settings.cta_font }}, sans-serif;
    font-weight: {{ block.settings.right_cta_font_weight }};
    display: inline-block;
    padding: 12px 30px;
    background-color: {{ block.settings.right_cta_bg_color }};
    color: {{ block.settings.right_cta_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.right_cta_border_radius }}px;
    font-size: {{ block.settings.right_cta_size }}px;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
  }

  .ai-split-banner__right-cta-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.right_cta_hover_bg_color }};
    color: {{ block.settings.right_cta_hover_text_color }};
  }

  .ai-split-banner__right-cta-link-{{ ai_gen_id }} {
    font-family: {{ block.settings.cta_font }}, sans-serif;
    font-weight: {{ block.settings.right_cta_font_weight }};
    color: {{ block.settings.right_cta_text_color }};
    text-decoration: underline;
    font-size: {{ block.settings.right_cta_size }}px;
  }

  .ai-split-banner__right-cta-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.right_cta_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-split-banner__container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.gap_mobile }}px;
    }

    .ai-split-banner__left-{{ ai_gen_id }},
    .ai-split-banner__right-{{ ai_gen_id }} {
      width: 100%;
      height: {{ block.settings.banner_height_mobile }}px;
    }

    .ai-split-banner__heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.left_heading_size }}px * 0.8);
    }

    .ai-split-banner__subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.left_subheading_size }}px * 0.9);
    }

    .ai-split-banner__right-heading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.right_heading_size }}px * 0.8);
    }

    .ai-split-banner__right-subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.right_subheading_size }}px * 0.9);
    }
  }
{% endstyle %}

<div class="ai-split-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-split-banner__container-{{ ai_gen_id }}">
    <div class="ai-split-banner__left-{{ ai_gen_id }}">
      {% if block.settings.left_image %}
        <img
          src="{{ block.settings.left_image | image_url: width: 2000 }}"
          alt="{{ block.settings.left_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.left_image.width }}"
          height="{{ block.settings.left_image.height }}"
          class="ai-split-banner__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-split-banner__placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}

      <div class="ai-split-banner__content-{{ ai_gen_id }} ai-split-banner__content--{{ block.settings.left_text_position }}-{{ ai_gen_id }}">
        {% if block.settings.left_heading != blank %}
          <h2 class="ai-split-banner__heading-{{ ai_gen_id }}">{{ block.settings.left_heading }}</h2>
        {% endif %}

        {% if block.settings.left_subheading != blank %}
          <div class="ai-split-banner__subheading-{{ ai_gen_id }}">{{ block.settings.left_subheading }}</div>
        {% endif %}

        {% if block.settings.left_cta_text != blank and block.settings.left_cta_link != blank %}
          {% if block.settings.left_cta_style == 'button' %}
            <a href="{{ block.settings.left_cta_link }}" class="ai-split-banner__cta-button-{{ ai_gen_id }}">
              {{ block.settings.left_cta_text }}
            </a>
          {% else %}
            <a href="{{ block.settings.left_cta_link }}" class="ai-split-banner__cta-link-{{ ai_gen_id }}">
              {{ block.settings.left_cta_text }}
            </a>
          {% endif %}
        {% endif %}
      </div>
    </div>

    <div class="ai-split-banner__right-{{ ai_gen_id }}">
      {% if block.settings.right_image %}
        <img
          src="{{ block.settings.right_image | image_url: width: 2000 }}"
          alt="{{ block.settings.right_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.right_image.width }}"
          height="{{ block.settings.right_image.height }}"
          class="ai-split-banner__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-split-banner__placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}

      <div class="ai-split-banner__content-{{ ai_gen_id }} ai-split-banner__content--{{ block.settings.right_text_position }}-{{ ai_gen_id }}">
        {% if block.settings.right_heading != blank %}
          <h2 class="ai-split-banner__right-heading-{{ ai_gen_id }}">{{ block.settings.right_heading }}</h2>
        {% endif %}

        {% if block.settings.right_subheading != blank %}
          <div class="ai-split-banner__right-subheading-{{ ai_gen_id }}">{{ block.settings.right_subheading }}</div>
        {% endif %}

        {% if block.settings.right_cta_text != blank and block.settings.right_cta_link != blank %}
          {% if block.settings.right_cta_style == 'button' %}
            <a href="{{ block.settings.right_cta_link }}" class="ai-split-banner__right-cta-button-{{ ai_gen_id }}">
              {{ block.settings.right_cta_text }}
            </a>
          {% else %}
            <a href="{{ block.settings.right_cta_link }}" class="ai-split-banner__right-cta-link-{{ ai_gen_id }}">
              {{ block.settings.right_cta_text }}
            </a>
          {% endif %}
        {% endif %}
      </div>
    </div>
  </div>
</div>

