{% doc %}
  @prompt
    can you create me a rich text block that matches the collection title and description as used on the site, heading font - aime, description font - univers sans, allow the text to sit desktop width
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-rich-text-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.alignment }};
  }

  .ai-collection-rich-text-{{ ai_gen_id }}__heading {
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    color: {{ block.settings.heading_color }};
    font-family: "Aime", sans-serif;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    line-height: 1.1;
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
  }

  .ai-collection-rich-text-{{ ai_gen_id }}__description {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: "Univers Sans", sans-serif;
    font-size: {{ block.settings.description_size }}px;
    line-height: {{ block.settings.description_line_height }};
    letter-spacing: {{ block.settings.description_letter_spacing }}px;
  }

  .ai-collection-rich-text-{{ ai_gen_id }}__description p {
    margin: 0 0 1em;
  }

  .ai-collection-rich-text-{{ ai_gen_id }}__description p:last-child {
    margin-bottom: 0;
  }

  .ai-collection-rich-text-{{ ai_gen_id }}__description a {
    color: {{ block.settings.link_color }};
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-rich-text-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-collection-rich-text-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-collection-rich-text-{{ ai_gen_id }}__description {
      font-size: {{ block.settings.mobile_description_size }}px;
    }
  }
{% endstyle %}

<div class="ai-collection-rich-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if collection != blank %}
    {% if block.settings.show_title and collection.title != blank %}
      <h1 class="ai-collection-rich-text-{{ ai_gen_id }}__heading">{{ collection.title | escape }}</h1>
    {% endif %}

    {% if block.settings.show_description and collection.description != blank %}
      <div class="ai-collection-rich-text-{{ ai_gen_id }}__description">
        {{ collection.description }}
      </div>
    {% endif %}
  {% else %}
    <h1 class="ai-collection-rich-text-{{ ai_gen_id }}__heading">Collection title</h1>
    <div class="ai-collection-rich-text-{{ ai_gen_id }}__description">
      <p>Add this block to a collection template to display the collection title and description.</p>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Collection rich text",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show title",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show description",
      "default": true
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "radio",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Size",
      "min": 20,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 34
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile size",
      "min": 18,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 28
    },
    {
      "type": "range",
      "id": "heading_weight",
      "label": "Weight",
      "min": 400,
      "max": 700,
      "step": 100,
      "default": 400
    },
    {
      "type": "range",
      "id": "heading_letter_spacing",
      "label": "Letter spacing",
      "min": -2,
      "max": 2,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_spacing",
      "label": "Space below",
      "min": 0,
      "max": 40,
      "step": 5,
      "unit": "px",
      "default": 15
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "range",
      "id": "description_size",
      "label": "Size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_description_size",
      "label": "Mobile size",
      "min": 12,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "description_line_height",
      "label": "Line height",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.5
    },
    {
      "type": "range",
      "id": "description_letter_spacing",
      "label": "Letter spacing",
      "min": -2,
      "max": 2,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#0e0e0e"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#0e0e0e"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Links",
      "default": "#0e0e0e"
    }
  ],
  "presets": [
    {
      "name": "Collection rich text"
    }
  ],
  "tag": null,
  "class": "collection-rich-text-block"
}
{% endschema %}