{% doc %}
  @prompt
    create a split banner block with the able to change the overlay text position via toggle, allow left banner to be width 65 and right to be width 35, allow spacing between two banners, show heading, subheading and cta link text of the left banner underneath the image on mobile, make the CTA links instead of buttons, allow different text colours, fonts and sizes for the left and right banners, allow the text on the left banner to be condensed to 275, mobile height layout to 200px
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-split-banner-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.banner_spacing }}px;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-split-banner__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.border_radius }}px;
  }

  .ai-split-banner__item--left-{{ ai_gen_id }} {
    width: 65%;
  }

  .ai-split-banner__item--right-{{ ai_gen_id }} {
    width: 35%;
  }

  .ai-split-banner__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: {{ block.settings.desktop_height }}px;
  }

  .ai-split-banner__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-split-banner__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: {{ block.settings.desktop_height }}px;
  }

  .ai-split-banner__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-split-banner__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }

  .ai-split-banner__overlay--top-left-{{ ai_gen_id }} {
    align-items: flex-start;
    justify-content: flex-start;
  }

  .ai-split-banner__overlay--top-center-{{ ai_gen_id }} {
    align-items: flex-start;
    justify-content: center;
  }

  .ai-split-banner__overlay--top-right-{{ ai_gen_id }} {
    align-items: flex-start;
    justify-content: flex-end;
  }

  .ai-split-banner__overlay--center-left-{{ ai_gen_id }} {
    align-items: center;
    justify-content: flex-start;
  }

  .ai-split-banner__overlay--center-center-{{ ai_gen_id }} {
    align-items: center;
    justify-content: center;
  }

  .ai-split-banner__overlay--center-right-{{ ai_gen_id }} {
    align-items: center;
    justify-content: flex-end;
  }

  .ai-split-banner__overlay--bottom-left-{{ ai_gen_id }} {
    align-items: flex-end;
    justify-content: flex-start;
  }

  .ai-split-banner__overlay--bottom-center-{{ ai_gen_id }} {
    align-items: flex-end;
    justify-content: center;
  }

  .ai-split-banner__overlay--bottom-right-{{ ai_gen_id }} {
    align-items: flex-end;
    justify-content: flex-end;
  }

  .ai-split-banner__content-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    max-width: 100%;
  }

  .ai-split-banner__content--left-{{ ai_gen_id }} {
    max-width: 275px;
  }

  .ai-split-banner__heading-{{ ai_gen_id }} {
    margin: 0 0 12px;
  }

  .ai-split-banner__heading--left-{{ ai_gen_id }} {
    color: {{ block.settings.left_heading_color }};
    font-size: {{ block.settings.left_heading_size }}px;
    font-family: {{ block.settings.left_heading_font.family }}, {{ block.settings.left_heading_font.fallback_families }};
    font-weight: {{ block.settings.left_heading_font.weight }};
    font-style: {{ block.settings.left_heading_font.style }};
  }

  .ai-split-banner__heading--right-{{ ai_gen_id }} {
    color: {{ block.settings.right_heading_color }};
    font-size: {{ block.settings.right_heading_size }}px;
    font-family: {{ block.settings.right_heading_font.family }}, {{ block.settings.right_heading_font.fallback_families }};
    font-weight: {{ block.settings.right_heading_font.weight }};
    font-style: {{ block.settings.right_heading_font.style }};
  }

  .ai-split-banner__subheading-{{ ai_gen_id }} {
    margin: 0 0 16px;
  }

  .ai-split-banner__subheading--left-{{ ai_gen_id }} {
    color: {{ block.settings.left_subheading_color }};
    font-size: {{ block.settings.left_subheading_size }}px;
    font-family: {{ block.settings.left_subheading_font.family }}, {{ block.settings.left_subheading_font.fallback_families }};
    font-weight: {{ block.settings.left_subheading_font.weight }};
    font-style: {{ block.settings.left_subheading_font.style }};
  }

  .ai-split-banner__subheading--right-{{ ai_gen_id }} {
    color: {{ block.settings.right_subheading_color }};
    font-size: {{ block.settings.right_subheading_size }}px;
    font-family: {{ block.settings.right_subheading_font.family }}, {{ block.settings.right_subheading_font.fallback_families }};
    font-weight: {{ block.settings.right_subheading_font.weight }};
    font-style: {{ block.settings.right_subheading_font.style }};
  }

  .ai-split-banner__cta-{{ ai_gen_id }} {
    display: inline-block;
    text-decoration: underline;
    transition: opacity 0.3s ease;
  }

  .ai-split-banner__cta--left-{{ ai_gen_id }} {
    color: {{ block.settings.left_cta_color }};
    font-size: {{ block.settings.left_cta_size }}px;
    font-family: {{ block.settings.left_cta_font.family }}, {{ block.settings.left_cta_font.fallback_families }};
    font-weight: {{ block.settings.left_cta_font.weight }};
    font-style: {{ block.settings.left_cta_font.style }};
  }

  .ai-split-banner__cta--right-{{ ai_gen_id }} {
    color: {{ block.settings.right_cta_color }};
    font-size: {{ block.settings.right_cta_size }}px;
    font-family: {{ block.settings.right_cta_font.family }}, {{ block.settings.right_cta_font.fallback_families }};
    font-weight: {{ block.settings.right_cta_font.weight }};
    font-style: {{ block.settings.right_cta_font.style }};
  }

  .ai-split-banner__cta-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-split-banner__mobile-content-{{ ai_gen_id }} {
    display: none;
  }

  @media screen and (max-width: 749px) {
    .ai-split-banner-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.mobile_banner_spacing }}px;
    }

    .ai-split-banner__item--left-{{ ai_gen_id }},
    .ai-split-banner__item--right-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-split-banner__image-wrapper-{{ ai_gen_id }} {
      min-height: 200px;
    }

    .ai-split-banner__image-placeholder-{{ ai_gen_id }} {
      min-height: 200px;
    }

    .ai-split-banner__overlay-{{ ai_gen_id }} {
      display: none;
    }

    .ai-split-banner__item--left-{{ ai_gen_id }} .ai-split-banner__overlay-{{ ai_gen_id }} {
      display: none;
    }

    .ai-split-banner__mobile-content-{{ ai_gen_id }} {
      display: block;
      padding: 16px 0;
    }

    .ai-split-banner__mobile-content-{{ ai_gen_id }} .ai-split-banner__heading-{{ ai_gen_id }} {
      margin-bottom: 8px;
    }

    .ai-split-banner__mobile-content-{{ ai_gen_id }} .ai-split-banner__subheading-{{ ai_gen_id }} {
      margin-bottom: 12px;
    }
  }
{% endstyle %}

<div class="ai-split-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-split-banner__item-{{ ai_gen_id }} ai-split-banner__item--left-{{ ai_gen_id }}">
    <div class="ai-split-banner__image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.left_image %}
        <img
          src="{{ block.settings.left_image | image_url: width: 2000 }}"
          alt="{{ block.settings.left_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.left_image.width }}"
          height="{{ block.settings.left_image.height }}"
          class="ai-split-banner__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-split-banner__image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}

      {% if block.settings.left_heading != blank or block.settings.left_subheading != blank or block.settings.left_cta_text != blank %}
        <div class="ai-split-banner__overlay-{{ ai_gen_id }} ai-split-banner__overlay--{{ block.settings.left_text_position }}-{{ ai_gen_id }}">
          <div class="ai-split-banner__content-{{ ai_gen_id }} ai-split-banner__content--left-{{ ai_gen_id }}">
            {% if block.settings.left_heading != blank %}
              <h2 class="ai-split-banner__heading-{{ ai_gen_id }} ai-split-banner__heading--left-{{ ai_gen_id }}">
                {{ block.settings.left_heading }}
              </h2>
            {% endif %}

            {% if block.settings.left_subheading != blank %}
              <div class="ai-split-banner__subheading-{{ ai_gen_id }} ai-split-banner__subheading--left-{{ ai_gen_id }}">
                {{ block.settings.left_subheading }}
              </div>
            {% endif %}

            {% if block.settings.left_cta_text != blank and block.settings.left_cta_link != blank %}
              <a
                href="{{ block.settings.left_cta_link }}"
                class="ai-split-banner__cta-{{ ai_gen_id }} ai-split-banner__cta--left-{{ ai_gen_id }}"
              >
                {{ block.settings.left_cta_text }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>

    {% if block.settings.left_heading != blank or block.settings.left_subheading != blank or block.settings.left_cta_text != blank %}
      <div class="ai-split-banner__mobile-content-{{ ai_gen_id }}">
        {% if block.settings.left_heading != blank %}
          <h2 class="ai-split-banner__heading-{{ ai_gen_id }} ai-split-banner__heading--left-{{ ai_gen_id }}">
            {{ block.settings.left_heading }}
          </h2>
        {% endif %}

        {% if block.settings.left_subheading != blank %}
          <div class="ai-split-banner__subheading-{{ ai_gen_id }} ai-split-banner__subheading--left-{{ ai_gen_id }}">
            {{ block.settings.left_subheading }}
          </div>
        {% endif %}

        {% if block.settings.left_cta_text != blank and block.settings.left_cta_link != blank %}
          <a
            href="{{ block.settings.left_cta_link }}"
            class="ai-split-banner__cta-{{ ai_gen_id }} ai-split-banner__cta--left-{{ ai_gen_id }}"
          >
            {{ block.settings.left_cta_text }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>

  <div class="ai-split-banner__item-{{ ai_gen_id }} ai-split-banner__item--right-{{ ai_gen_id }}">
    <div class="ai-split-banner__image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.right_image %}
        <img
          src="{{ block.settings.right_image | image_url: width: 2000 }}"
          alt="{{ block.settings.right_image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.right_image.width }}"
          height="{{ block.settings.right_image.height }}"
          class="ai-split-banner__image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-split-banner__image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}

      {% if block.settings.right_heading != blank or block.settings.right_subheading != blank or block.settings.right_cta_text != blank %}
        <div class="ai-split-banner__overlay-{{ ai_gen_id }} ai-split-banner__overlay--{{ block.settings.right_text_position }}-{{ ai_gen_id }}">
          <div class="ai-split-banner__content-{{ ai_gen_id }}">
            {% if block.settings.right_heading != blank %}
              <h2 class="ai-split-banner__heading-{{ ai_gen_id }} ai-split-banner__heading--right-{{ ai_gen_id }}">
                {{ block.settings.right_heading }}
              </h2>
            {% endif %}

            {% if block.settings.right_subheading != blank %}
              <div class="ai-split-banner__subheading-{{ ai_gen_id }} ai-split-banner__subheading--right-{{ ai_gen_id }}">
                {{ block.settings.right_subheading }}
              </div>
            {% endif %}

            {% if block.settings.right_cta_text != blank and block.settings.right_cta_link != blank %}
              <a
                href="{{ block.settings.right_cta_link }}"
                class="ai-split-banner__cta-{{ ai_gen_id }} ai-split-banner__cta--right-{{ ai_gen_id }}"
              >
                {{ block.settings.right_cta_text }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
</div>

